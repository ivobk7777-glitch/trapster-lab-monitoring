      "targets": [
        {
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "editorMode": "code",
          "expr": "sum by (src_ip) (count_over_time({job=\"trapster\"} | json src_ip=\"src_ip\" | __error__=\"\" [$__range]))",
          "queryType": "instant",
          "refId": "A",
          "format": "table"
        },
        {
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "editorMode": "code",
          "expr": "count by (src_ip) (sum by (src_ip, service) (label_replace(sum by (src_ip, logtype) (count_over_time({job=\"trapster\"} | json src_ip=\"src_ip\" | __error__=\"\" [$__range])), \"service\", \"$1\", \"logtype\", \"([^.]+)[.].*\")))",
          "queryType": "instant",
