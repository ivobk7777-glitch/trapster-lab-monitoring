{
  "uid": "trapster-honeypot",
  "title": "Trapster honeypot",
  "description": "Trapster Community honeypot on linux-server01 (192.168.20.10). Every event is a possible intruder; email alerts go out per attacker IP.",
  "tags": [
    "honeypot",
    "trapster",
    "lab"
  ],
  "timezone": "utc",
  "editable": true,
  "graphTooltip": 1,
  "time": {
    "from": "now-7d",
    "to": "now"
  },
  "timepicker": {
    "refresh_intervals": [
      "10s",
      "30s",
      "1m",
      "5m",
      "15m",
      "1h"
    ]
  },
  "refresh": "30s",
  "schemaVersion": 39,
  "version": 3,
  "annotations": {
    "list": []
  },
  "templating": {
    "list": []
  },
  "links": [
    {
      "title": "Alert rules",
      "type": "link",
      "url": "/alerting/list",
      "icon": "bell",
      "targetBlank": false,
      "asDropdown": false,
      "includeVars": false,
      "keepTime": false,
      "tags": []
    }
  ],
  "panels": [
    {
      "id": 1,
      "type": "text",
      "title": "",
      "transparent": true,
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 3
      },
      "options": {
        "mode": "markdown",
        "content": "**How to read this dashboard.** Nothing legitimate ever connects to the honeypot (192.168.20.10), so **every event here is a possible intruder**. The user gets one email per attacker IP. *Note:* Trapster logs completed connections, so a half-open SYN scan (`nmap -sS`) only shows up on the UDP services (DNS, SNMP); a connect scan, banner grab or login attempt shows up on every port."
      }
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Activity in the last hour",
      "description": "Events in the last 60 minutes, whatever time range is selected. Red means someone touched the honeypot recently.",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "gridPos": {
        "x": 0,
        "y": 3,
        "w": 6,
        "h": 4
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "unit": "none",
          "noValue": "0",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "value",
        "justifyMode": "center",
        "orientation": "auto",
        "wideLayout": true,
        "showPercentChange": false
      },
      "targets": [
        {
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "editorMode": "code",
          "expr": "sum(count_over_time({job=\"trapster\"}[1h]))",
          "queryType": "instant",
          "refId": "A"
        }
      ]
    },
