    {
      "id": 5,
      "type": "timeseries",
      "title": "Events over time, by type",
      "description": "Stacked count of events per interval. logtype is a Loki label set by Alloy.",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "gridPos": {
        "x": 0,
        "y": 4,
        "w": 16,
        "h": 9
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          },
          "unit": "none",
          "custom": {
            "drawStyle": "bars",
            "fillOpacity": 80,
            "lineWidth": 1,
            "stacking": {
              "mode": "normal",
              "group": "A"
            },
            "axisPlacement": "auto",
            "showPoints": "never"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "editorMode": "code",
          "expr": "sum by (logtype) (count_over_time({job=\"trapster\"}[$__auto]))",
          "queryType": "range",
          "refId": "A",
          "legendFormat": "{{logtype}}"
        }
      ]
    },
    {
      "id": 6,
      "type": "piechart",
      "title": "Events by type",
