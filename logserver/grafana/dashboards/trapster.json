          "values": [
            "value"
          ]
        },
        "tooltip": {
          "mode": "single",
          "sort": "none"
        }
      },
      "maxDataPoints": 30,
      "targets": [
        {
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "editorMode": "code",
          "expr": "sum by (logtype) (count_over_time({job=\"trapster\"}[$__range]))",
          "queryType": "range",
          "refId": "A",
          "legendFormat": "{{logtype}}"
        }
      ]
    },
    {
      "id": 7,
      "type": "bargauge",
      "title": "Top source IPs",
      "description": "Source addresses with the most events. In the lab this should be Kali, 192.168.10.10.",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "gridPos": {
        "x": 0,
        "y": 13,
        "w": 8,
        "h": 9
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "continuous-GrYlRd"
          },
          "unit": "none",
          "min": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "orientation": "horizontal",
        "displayMode": "gradient",
        "showUnfilled": true,
        "namePlacement": "left",
        "valueMode": "color",
        "sizing": "auto",
        "minVizHeight": 16,
        "minVizWidth": 8,
        "maxVizHeight": 300
      },
      "maxDataPoints": 30,
      "targets": [
        {
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "editorMode": "code",
          "expr": "topk(10, sum by (src_ip) (count_over_time({job=\"trapster\"} | json | __error__=\"\"[$__range])))",
          "queryType": "range",
          "refId": "A",
          "legendFormat": "{{src_ip}}"
        }
      ]
    },
    {
      "id": 8,
      "type": "logs",
      "title": "HTTP and HTTPS request log",
      "description": "One line per request: source, protocol, method, path, status code, user agent.",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "gridPos": {
        "x": 8,
        "y": 13,
        "w": 16,
        "h": 9
      },
      "options": {
        "showTime": true,
        "wrapLogMessage": true,
        "sortOrder": "Descending",
        "dedupStrategy": "none",
        "enableLogDetails": true,
        "prettifyLogMessage": false,
        "showCommonLabels": false,
        "showLabels": false,
        "enableInfiniteScrolling": false
      },
      "targets": [
        {
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "editorMode": "code",
          "expr": "{job=\"trapster\", logtype=~\"https?.query\"} | json | __error__=\"\" | line_format \"{{.src_ip}}:{{.src_port}}  {{.logtype}}  {{.extra_method}} {{.extra_target}} -> {{.extra_status_code}}  UA={{.extra_headers_user_agent}}\"",
          "queryType": "range",
          "refId": "A",
          "maxLines": 200
        }
      ]
    },
    {
      "id": 9,
      "type": "logs",
      "title": "DNS query log",
      "description": "Queries received by the DNS honeypot (UDP). The name is shown as labels, e.g. [example, com]. Type 1 = A, 28 = AAAA, 15 = MX.",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "gridPos": {
        "x": 0,
        "y": 22,
        "w": 12,
        "h": 9
      },
      "options": {
        "showTime": true,
        "wrapLogMessage": true,
        "sortOrder": "Descending",
        "dedupStrategy": "none",
        "enableLogDetails": true,
        "prettifyLogMessage": false,
        "showCommonLabels": false,
        "showLabels": false,
        "enableInfiniteScrolling": false
      },
      "targets": [
        {
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "editorMode": "code",
          "expr": "{job=\"trapster\", logtype=\"dns.query\"} | json src_ip=\"src_ip\", src_port=\"src_port\", domain=\"extra.query.questions[0].domain_name\", qtype=\"extra.query.questions[0].query_type\" | __error__=\"\" | line_format \"{{.src_ip}}:{{.src_port}}  DNS  {{.domain}}  type {{.qtype}}\"",
          "queryType": "range",
          "refId": "A",
          "maxLines": 200
        }
      ]
    },
