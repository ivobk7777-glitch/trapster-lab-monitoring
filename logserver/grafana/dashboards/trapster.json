    {
      "id": 10,
      "type": "logs",
      "title": "Activity feed",
      "description": "Every event as one readable line, newest first. Yellow = contact, red = login attempt. Expand a line for all fields.",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "gridPos": {
        "x": 0,
        "y": 24,
        "w": 14,
        "h": 11
      },
      "options": {
        "showTime": true,
        "wrapLogMessage": true,
        "sortOrder": "Descending",
        "dedupStrategy": "none",
        "enableLogDetails": true,
        "prettifyLogMessage": false,
        "showCommonLabels": false,
        "showLabels": false,
        "enableInfiniteScrolling": false
      },
      "targets": [
        {
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "editorMode": "code",
          "expr": "{job=\"trapster\"} | json src_ip=\"src_ip\", dst_port=\"dst_port\", method=\"extra.method\", path=\"extra.target\", user=\"extra.username\", pass=\"extra.password\", domain=\"extra.query.questions[0].domain_name\", community=\"extra.community\", module=\"extra.module\" | __error__=\"\" | label_format level=`{{ if hasSuffix \"login\" .logtype }}critical{{ else }}warning{{ end }}`, detected_level=`{{ if hasSuffix \"login\" .logtype }}critical{{ else }}warning{{ end }}` | line_format `{{.src_ip}}  ->  {{.logtype}} (port {{.dst_port}}){{ if .method }}  {{.method}} {{.path}}{{ end }}{{ if .domain }}  {{.domain}}{{ end }}{{ if .community }}  community=\"{{.community}}\"{{ end }}{{ if .module }}  module={{.module}}{{ end }}{{ if .user }}  user=\"{{.user}}\" password=\"{{.pass}}\"{{ end }}`",
          "queryType": "range",
          "refId": "A",
          "maxLines": 300
        }
      ]
    },
